[Unit]
Description=AgInTi workstation document artifact worker
Documentation=https://flow.lazying.art
After=local-fs.target

[Service]
Type=simple
User=aginti-document-worker
Group=aginti-document-worker
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/var/lib/aginti-document-worker
ExecStartPre=/opt/agintiflow-document-worker/runtimes/node-v22.21.0-29e9c28204d89d85/bin/node /opt/agintiflow-document-worker/releases/RELEASE_SHA256/bin/aginti-document-worker-runtime-check.js
ExecStartPre=/opt/agintiflow-document-worker/runtimes/node-v22.21.0-29e9c28204d89d85/bin/node /opt/agintiflow-document-worker/releases/RELEASE_SHA256/bin/aginti-document-worker.js check --config /etc/agintiflow/document-worker.json
ExecStart=/opt/agintiflow-document-worker/runtimes/node-v22.21.0-29e9c28204d89d85/bin/node /opt/agintiflow-document-worker/releases/RELEASE_SHA256/bin/aginti-document-worker.js serve --config /etc/agintiflow/document-worker.json
LoadCredential=document-worker-upstream-token:/etc/agintiflow/credentials/document-worker-upstream-token
StateDirectory=aginti-document-worker
StateDirectoryMode=0700
RuntimeDirectory=aginti-document-worker
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=2s
TimeoutStartSec=120s
TimeoutStopSec=15s
KillMode=mixed
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
RestrictNamespaces=~time
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=tcp:18102
ReadOnlyPaths=/etc/agintiflow/document-worker.json
InaccessiblePaths=/etc/agintiflow/credentials
InaccessiblePaths=/var/lib/lazyedge
InaccessiblePaths=/var/lib/agintiflow-integration
MemoryMax=1610612736
MemorySwapMax=0
TasksMax=64
CPUQuota=200%
CPUQuotaPeriodSec=100ms
LimitNOFILE=512
LimitCORE=0
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
