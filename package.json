{
  "name": "@lazyingart/agintilite",
  "version": "0.1.0-preview.23",
  "private": true,
  "description": "Bounded text-only application tool loop with explicit providers and read-only callbacks.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/restricted-application.js",
    "./restricted-application": "./src/restricted-application.js",
    "./deepseek-http": "./src/restricted-deepseek-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/restricted-application.js",
    "src/restricted-application-contract.js",
    "src/redaction.js",
    "src/restricted-deepseek-http.js",
    "src/restricted-deepseek-client.js",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node --experimental-test-module-mocks --test test/*.test.js",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts --offline",
    "pack:local": "node scripts/pack-local.mjs"
  }
}
